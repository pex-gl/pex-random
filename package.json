{
  "name": "pex-random",
  "version": "3.0.0",
  "description": "Random value generators (float, int, vector and noise) for PEX.",
  "keywords": [
    "pex",
    "random",
    "webgl",
    "3d",
    "seed",
    "noise",
    "float",
    "vector"
  ],
  "homepage": "https://github.com/pex-gl/pex-random",
  "bugs": "https://github.com/pex-gl/pex-random/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pex-gl/pex-random.git"
  },
  "license": "MIT",
  "author": "Marcin Ignac <marcin.ignac@gmail.com> (http://marcinignac.com)",
  "contributors": [
    "Damien Seguin (https://github.com/dmnsgn)"
  ],
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./index.js"
    }
  },
  "main": "./index.js",
  "types": "./types/index.d.ts",
  "scripts": {
    "build": "snowdev build",
    "dev": "snowdev dev",
    "release": "snowdev release",
    "test": "node --experimental-test-coverage test",
    "test:watch": "node --watch --experimental-test-coverage test"
  },
  "dependencies": {
    "seedrandom": "^3.0.5",
    "simplex-noise": "^4.0.3"
  },
  "devDependencies": {
    "es-module-shims": "^2.8.4",
    "pex-geom": "^3.1.2",
    "pex-math": "^4.4.0"
  },
  "peerDependencies": {
    "pex-math": "^4.4.0"
  },
  "peerDependenciesMeta": {
    "pex-math": {
      "optional": true
    }
  },
  "packageManager": "npm@11.3.0",
  "engines": {
    "node": ">=24.0.0",
    "snowdev": ">=3.0.0-alpha.3"
  }
}
